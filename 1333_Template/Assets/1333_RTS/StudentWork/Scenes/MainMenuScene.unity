  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Welcome!\n\nIn this game, you need to defend your barracks against hordes
    of enemy armies trying to destroy them.\n\nUse Q and E to rotate through the
    units you have available; the unit displayed is your active unit.\n\nPress the
    number keys 1 through 9 to spawn the active unit in the desired lane\u20141 is
    the lane closest to you.\n\nRemember that each unit costs resources, so try not
    to waste them unless you really need to. You can also spend resources to rebuild
    any destroyed barracks. Each barracks spans three lanes, and if it\u2019s destroyed
    you won\u2019t be able to spawn units in those lanes until you rebuild it.\n\nIf
    all your barracks are destroyed, it\u2019s game over. Try to survive as long
    as possible and aim for the highest score.\n\nGood luck!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
